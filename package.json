{
  "name": "family-game-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:ui": "node scripts/browser-ui-regression.mjs",
    "check": "tsc --noEmit && vitest run --passWithNoTests && vite build",
    "deploy": "pnpm run build && scp -P 1991 -r dist/* ubuntu@101.42.50.27:/home/www/games"
  },
  "dependencies": {
    "@phosphor-icons/core": "2.1.1",
    "phaser": "4.2.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@10.28.1"
}
